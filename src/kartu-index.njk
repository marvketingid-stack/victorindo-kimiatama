---
# Tujuan QR kartu nama: /kartu/?id=<kode>  → diarahkan ke /kartu/<kode>/
# Kode tidak dikenal → tampil pesan + kontak kantor.
permalink: kartu/index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Kartu Nama | {{ site.companyName }}</title>
<link rel="icon" type="image/png" href="{{ site.favicon }}">
<script>
  (function () {
    var ids = {{ kartuIds | dump | safe }};
    var id = (new URLSearchParams(location.search).get("id") || "").trim().toLowerCase();
    if (/^[a-z0-9-]+$/.test(id) && ids.indexOf(id) !== -1) location.replace("/kartu/" + id + "/");
    else document.documentElement.className = "nf";
  })();
</script>
<style>
  body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:linear-gradient(160deg,#4a0404,#210000 55%,#1a1c1c);min-height:100vh;display:grid;place-items:center;padding:24px;box-sizing:border-box;color:#1a1c1c}
  .box{display:none;max-width:420px;width:100%;background:#fff;border-radius:16px;padding:28px 24px;text-align:center}
  .nf .box{display:block}
  .box img{width:44px;height:44px}
  h1{font-size:18px;margin:12px 0 6px}
  p{font-size:14px;color:#554240;margin:0 0 18px}
  a{display:block;padding:13px;border-radius:10px;font-weight:600;font-size:14px;text-decoration:none;margin-top:8px}
  .wa{background:#9A1208;color:#fff}
  .web{background:#F9F6F1;color:#9A1208;border:1px solid #e6dccd}
</style>
</head>
<body>
  <div class="box">
    <img src="{{ site.logo }}" alt="Logo {{ site.companyName }}">
    <h1>Kartu nama tidak ditemukan</h1>
    <p>Silakan hubungi kantor {{ site.companyName }} melalui kontak di bawah.</p>
    <a class="wa" href="https://wa.me/{{ site.phoneHref | replace('tel:+', '') | replace('tel:', '') }}" target="_blank" rel="noopener">WhatsApp Kantor</a>
    <a class="web" href="/id/">Kunjungi website →</a>
  </div>
</body>
</html>
