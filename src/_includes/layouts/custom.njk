---
layout: layouts/base.njk
---
{%- set t = ui[lang] %}
{%- set root = "/" if lang == "en" else "/id/" %}

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.home[lang].url }}">{{ t.nav.home }}</a><span class="sep">/</span><span class="current">{{ title }}</span>
      </nav>
      {%- if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
      <h1 class="headline-lg">{{ title }}</h1>
      {%- if date or topics %}
      <div class="news-meta">
        {%- if date %}<time datetime="{{ date | dateISO }}">{{ date | newsDate(lang) }}</time>{% endif %}
        {%- if topics %}{% for tp in topics %}<span class="news-tag">{{ tp }}</span>{% endfor %}{% endif %}
      </div>
      {%- endif %}
      {%- if description %}<p class="lede">{{ description }}</p>{% endif %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {%- if heroImage %}
    <div class="media reveal mb-48" style="border:2px solid var(--stroke-dark);max-width:960px;">
      <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}">
    </div>
    {%- endif %}

    {%- if blocks and blocks.length %}
    <div class="article-body">
      {%- for b in blocks %}
      {%- if b.type == "text" %}
        <div class="prose">{{ b.content | markdownify | safe }}</div>
      {%- elif b.type == "heading" %}
        <h2 class="article-heading">{{ b.text }}</h2>
      {%- elif b.type == "image" %}
        <figure class="article-figure">
          <img src="{{ b.image }}" alt="{{ b.alt or b.caption or title }}" loading="lazy">
          {%- if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
        </figure>
      {%- elif b.type == "twoImages" %}
        <figure class="article-figure article-figure-two">
          <div class="two-up">
            <img src="{{ b.imageLeft }}" alt="{{ b.caption or title }}" loading="lazy">
            <img src="{{ b.imageRight }}" alt="{{ b.caption or title }}" loading="lazy">
          </div>
          {%- if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
        </figure>
      {%- elif b.type == "quote" %}
        <blockquote class="article-quote">
          <p>{{ b.text }}</p>
          {%- if b.cite %}<cite>{{ b.cite }}</cite>{% endif %}
        </blockquote>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- else %}
    <div class="prose">
{{ content | safe }}
    </div>
    {%- endif %}
  </div>
</section>
