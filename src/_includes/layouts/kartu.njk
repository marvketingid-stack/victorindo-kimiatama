<!DOCTYPE html>
{#- Kartu Nama Digital karyawan (tujuan QR code di kartu nama).
    Data per orang: src/kartu/<nama>.md (diisi lewat /admin → 🪪 Kartu Nama Karyawan).
    Halaman berdiri sendiri (tanpa navbar situs) supaya ringan & fokus saat dibuka dari HP. -#}
{%- set active = aktif !== false %}
{%- set coWa = site.phoneHref | replace("tel:+", "") | replace("tel:", "") %}
{%- if active %}
  {%- set showName = nama %}
  {%- set showRole = jabatan %}
  {%- set showWa = waNumber %}
  {%- set showWaText = waDisplay %}
  {%- set showMail = email %}
  {%- set greet = firstName %}
{%- else %}
  {%- set showName = site.companyName %}
  {%- set showRole = "Kantor Pusat" %}
  {%- set showWa = coWa %}
  {%- set showWaText = site.phone %}
  {%- set showMail = site.email %}
  {%- set greet = "Victorindo" %}
{%- endif %}
{%- set waMsg = "Halo " + greet + ", saya mendapat kontak Anda dari kartu nama " + site.companyName + ". " %}
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ showName }} | {{ site.companyName }}</title>
<meta property="og:title" content="{{ showName }} — {{ site.companyName }}">
<meta property="og:description" content="{{ showRole }} · {{ site.companyName }}">
<meta property="og:image" content="{{ site.baseUrl }}{{ site.defaultShareImage }}">
<link rel="icon" type="image/png" href="{{ site.favicon }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --surface:#faf9f9; --cream:#F9F6F1; --white:#fff;
    --ink:#1a1c1c; --muted:#6B6B6B; --line:#e3e2e2;
    --primary:#210000; --primary-container:#4a0404;
    --crimson:#9A1208; --rust:#D63F13;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:Inter,system-ui,-apple-system,sans-serif;background:var(--surface);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:480px;margin:0 auto;min-height:100vh;background:var(--white);box-shadow:0 0 0 1px var(--line)}

  .top{display:flex;align-items:center;gap:10px;padding:14px 20px;border-bottom:1px solid var(--line)}
  .top img{width:34px;height:34px;object-fit:contain}
  .top b{display:block;font-family:Montserrat,sans-serif;font-size:13px;letter-spacing:.02em;text-transform:uppercase}
  .top small{display:block;font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--rust);letter-spacing:.08em}
  .btn.site{grid-column:1/-1;min-height:44px;font-size:13.5px;color:var(--crimson);background:var(--cream);border-color:#e6dccd}
  @media (max-width:400px){
    .top{padding:12px 14px;gap:8px}
    .top img{width:28px;height:28px}
    .top b{font-size:11px;letter-spacing:0}
    .top small{font-size:8.5px;letter-spacing:.04em;white-space:nowrap}
  }

  .hero{background:linear-gradient(160deg,rgba(74,4,4,.62),rgba(33,0,0,.80)),url('/assets/img/factory-aerial.webp') center 40%/cover no-repeat,var(--primary);color:#fff;padding:44px 24px 92px}
  .eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#f3b29e;display:flex;align-items:center;gap:8px}
  .eyebrow::before{content:"";width:22px;height:1px;background:var(--rust)}
  .profile{margin:-52px 20px 0;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:22px;position:relative;box-shadow:0 10px 30px -18px rgba(33,0,0,.45)}
  .role{font-family:'JetBrains Mono',monospace;color:var(--crimson);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
  h1{font-family:Montserrat,sans-serif;font-weight:800;font-size:17px;line-height:1.2;margin-top:4px}

  .notice{margin:20px 20px 0;padding:14px 16px;border-radius:10px;background:#fff4ef;border:1px solid #f6c9b6;font-size:14px;color:#6a1c0c}

  .actions{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;border-radius:10px;font-weight:600;font-size:14.5px;border:1px solid var(--line);background:var(--white);color:var(--ink)}
  .btn svg{width:18px;height:18px;flex:none}
  .btn.wa{background:var(--crimson);border-color:var(--crimson);color:#fff}
  .btn:active{transform:scale(.98)}

  .sec{padding:4px 20px 20px}
  .sec h2{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:8px 0 10px}
  .row{display:flex;gap:14px;align-items:flex-start;padding:13px 0}
  .row + .row{border-top:1px solid var(--line)}
  .row svg{width:18px;height:18px;color:var(--crimson);flex:none;margin-top:2px}
  .row small{display:block;font-size:12px;color:var(--muted)}
  .row span{font-size:14.5px;word-break:break-word}

  .company{margin:8px 20px 24px;padding:18px;background:var(--cream);border-radius:12px}
  .company b{font-family:Montserrat,sans-serif;font-size:15px}
  .company p{font-size:13.5px;color:#554240;margin-top:6px}
  .certs{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
  .certs span{font-size:11px;font-weight:600;padding:3px 8px;border-radius:4px;background:#fff;border:1px solid #e6dccd}

  footer{text-align:center;font-size:11.5px;color:var(--muted);padding:0 20px 28px}

  @media (min-width:700px){
    body{background:linear-gradient(160deg,#4a0404 0%,#210000 55%,#1a1c1c 100%);min-height:100vh;padding:48px 16px}
    .wrap{min-height:0;border-radius:18px;overflow:hidden;box-shadow:0 30px 80px -30px rgba(0,0,0,.6)}
  }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <img src="{{ site.logo }}" alt="Logo {{ site.companyName }}">
    <div><b>{{ site.companyName }}</b><small>SINCE 1978 · PROVEN RESULTS</small></div>
  </header>

  <section class="hero"><div class="eyebrow">Kontak Resmi Karyawan</div></section>

  <article class="profile">
    {%- if showRole %}<div class="role">{{ showRole }}</div>{% endif %}
    <h1>{{ showName }}</h1>
  </article>

  {%- if not active %}
  <div class="notice">Karyawan ini sudah tidak bertugas. Silakan hubungi kantor kami melalui kontak di bawah.</div>
  {%- endif %}

  <div class="actions">
    <a class="btn wa" href="https://wa.me/{{ showWa }}?text={{ waMsg | urlencode }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
      WhatsApp
    </a>
    <a class="btn" href="mailto:{{ showMail }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      Email
    </a>
    <a class="btn site" href="/id/">Kunjungi website →</a>
  </div>

  <section class="sec">
    <h2>Detail Kontak</h2>
    <div class="row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg><div><small>WhatsApp</small><span>{{ showWaText }}</span></div></div>
    <div class="row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg><div><small>Email</small><span>{{ showMail }}</span></div></div>
    <a class="row" href="https://maps.google.com/?q={{ (site.companyName + ' ' + site.address) | urlencode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><div><small>Kantor &amp; Pabrik</small><span>{{ site.address }}</span></div></a>
  </section>

  <section class="company">
    <b>Spesialis Cat &amp; Coating sejak 1978</b>
    <p>Produsen cat otomotif, marine/protective, dan arsitektur. Base coat, clear coat, epoxy, thinner, hardener, dan putty.</p>
    <div class="certs"><span>ISO 9001</span><span>ISO 14001</span><span>ISO 45001</span><span>TKDN</span><span>BKI</span></div>
  </section>

  <footer>© {{ "" | dateISO | truncate(4, true, "") }} {{ site.companyName }}</footer>
</div>
</body>
</html>
