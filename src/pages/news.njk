---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ routes.news[lang].file }}"
layout: layouts/base.njk
pageKey: news
eleventyExcludeFromCollections: true
---
{%- set t = ui[lang] %}
{%- set isID = lang == "id" %}
{%- set title = "Berita & Promo" if isID else "News & Updates" %}
{%- set description = "Kabar terbaru dan pengumuman dari PT Victorindo Kimiatama." if isID else "Latest news and announcements from PT Victorindo Kimiatama." %}

<section class="page-hero">
  <div class="container">
    <div class="page-hero-inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.home[lang].url }}">{{ t.nav.home }}</a><span class="sep">/</span>
        <span class="current">{{ title }}</span>
      </nav>
      <span class="eyebrow">{{ "Kabar Terbaru" if isID else "Latest Updates" }}</span>
      <h1 class="headline-lg">{{ title }}</h1>
      <p class="lede">{{ description }}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {%- set posts = collections.customPage | reverse %}
    {%- set count = 0 %}
    {%- for post in posts %}{% if post.data.lang == lang %}{% set count = count + 1 %}{% endif %}{% endfor %}

    {%- if count > 0 %}
    <div class="portfolio-grid">
      {%- for post in posts %}
      {%- if post.data.lang == lang %}
      <article class="portfolio-item">
        {%- if post.data.heroImage %}
        <a class="media" href="{{ post.url }}"><img src="{{ post.data.heroImage }}" alt="{{ post.data.heroImageAlt or post.data.title }}" loading="lazy"></a>
        {%- endif %}
        <div class="caption">
          {%- if post.data.eyebrow %}<span class="cat">{{ post.data.eyebrow }}</span>{% endif %}
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          {%- if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
          <div class="mt-16"><a class="btn btn-outline" href="{{ post.url }}">{{ "Baca Selengkapnya" if isID else "Read More" }} <span class="arrow">&rarr;</span></a></div>
        </div>
      </article>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- else %}
    <div class="card card-accent card-pad" style="max-width:640px;">
      <span class="label-caps text-crimson">{{ "Belum Ada" if isID else "Nothing Yet" }}</span>
      <p class="body-md mt-16 text-muted">
        {{ "Belum ada berita atau promo yang dipublikasikan. Halaman baru yang dibuat lewat menu \"Halaman Baru\" di admin akan otomatis muncul di sini." if isID else "No news or updates have been published yet. New pages created via the \"Halaman Baru\" menu in the admin will appear here automatically." }}
      </p>
    </div>
    {%- endif %}
  </div>
</section>
